# Copy this file to .env and fill in your values.
# Never commit .env. The Home Assistant token must stay on the server
# (environment variable or Docker secret) and is never sent to the browser.

# --- required ---
# Base URL of your Home Assistant instance (no trailing slash).
HA_URL=http://homeassistant.local:8123
# Long-lived access token, created in Home Assistant:
# Profile → Security → Long-lived access tokens.
HA_TOKEN=replace-with-a-long-lived-access-token

# --- server ---
PORT=3000
HOST=0.0.0.0
# IANA timezone used for cheap-rate windows, plans and daily totals.
TZ=Europe/London

# Set to false to reject all control POSTs (UI still works; actions return 403).
ALLOW_ACTIONS=true

# Where Hearth keeps its own files: audit.jsonl, settings.json, variables.json,
# VAPID keys, push subscriptions and alert state.
# Defaults to server/data, or /app/data in the container. Must be writable.
# DATA_DIR=/app/data

# --- alerts (optional; Settings in the UI override these after first save) ---
ALERTS_ENABLED=true
ALERT_INTERVAL_SEC=120
ALERT_EXPORT_SPIKE_P=30
ALERT_PW_LOW_PCT=20
ALERT_PW_MORNING_MIN_PCT=50
# Alert if a planned EV charge delivered less than this fraction of Predbat's plan.
ALERT_CHARGE_MIN_FRACTION=0.5
ALERT_COOLDOWN_MIN=60
ALERT_MAX_PER_HOUR=6
# e.g. 23:00-07:00 (alerts still show in the app, just no notifications)
ALERT_QUIET_HOURS=
ALERT_CAR_LOST_MIN=30
ALERT_DAILY_COST_GBP=2.00
ALERT_DAILY_COST_STEP_GBP=0.50

# Web Push contact (VAPID subject). Keys are generated automatically on first start.
VAPID_SUBJECT=mailto:hearth@localhost

# Optional Telegram seed values. Easier to set in Settings → Telegram alerts,
# where the bot token is stored write-only on the server and never returned to the browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public URL of this Hearth instance, used for Telegram deep links (no trailing slash).
# Example: https://hearth.example.com
# PUBLIC_URL=https://hearth.example.com
